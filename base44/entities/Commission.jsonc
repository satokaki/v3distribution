{
  "name": "Commission",
  "type": "object",
  "properties": {
    "code": {
      "type": "string",
      "title": "Kode Komisi"
    },
    "date": {
      "type": "string",
      "title": "Tanggal"
    },
    "salesperson_id": {
      "type": "string",
      "title": "Sales"
    },
    "salesperson_name": {
      "type": "string",
      "title": "Nama Sales"
    },
    "branch_id": {
      "type": "string",
      "title": "Cabang"
    },
    "branch_code": {
      "type": "string",
      "title": "Kode Cabang"
    },
    "sale_id": {
      "type": "string",
      "title": "Penjualan"
    },
    "sale_code": {
      "type": "string",
      "title": "Kode Penjualan"
    },
    "sale_total": {
      "type": "number",
      "title": "Nilai Penjualan",
      "default": 0
    },
    "rate": {
      "type": "number",
      "title": "Rate (%)",
      "default": 0
    },
    "amount": {
      "type": "number",
      "title": "Jumlah Komisi",
      "default": 0
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "accrued",
        "paid"
      ],
      "default": "accrued"
    },
    "paid_date": {
      "type": "string",
      "title": "Tanggal Dibayar"
    },
    "account_id": {
      "type": "string",
      "title": "Rekening"
    },
    "account_name": {
      "type": "string",
      "title": "Nama Rekening"
    },
    "note": {
      "type": "string",
      "title": "Catatan"
    }
  },
  "required": [
    "code",
    "date",
    "salesperson_id",
    "branch_id",
    "amount",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.branch_id": {
            "$in": "{{user.data.accessible_branch_ids}}"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.branch_id": {
            "$in": "{{user.data.accessible_branch_ids}}"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.branch_id": {
            "$in": "{{user.data.accessible_branch_ids}}"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.branch_id": {
            "$in": "{{user.data.accessible_branch_ids}}"
          }
        }
      ]
    }
  }
}