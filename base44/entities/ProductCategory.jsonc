{
  "name": "ProductCategory",
  "type": "object",
  "properties": {
    "code": {
      "type": "string",
      "title": "Kode Kategori"
    },
    "name": {
      "type": "string",
      "title": "Nama Kategori"
    },
    "description": {
      "type": "string",
      "title": "Deskripsi"
    },
    "sync_enabled": {
      "type": "boolean",
      "title": "Sinkron Antar Cabang",
      "default": true
    },
    "is_active": {
      "type": "boolean",
      "title": "Status Aktif",
      "default": true
    }
  },
  "required": [
    "code",
    "name"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}