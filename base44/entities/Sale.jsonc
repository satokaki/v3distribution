{
  "name": "Sale",
  "type": "object",
  "properties": {
    "code": {
      "type": "string",
      "title": "Kode Penjualan"
    },
    "date": {
      "type": "string",
      "title": "Tanggal"
    },
    "customer_id": {
      "type": "string",
      "title": "Pelanggan"
    },
    "customer_name": {
      "type": "string",
      "title": "Nama Pelanggan"
    },
    "branch_id": {
      "type": "string",
      "title": "Cabang"
    },
    "branch_code": {
      "type": "string",
      "title": "Kode Cabang"
    },
    "warehouse_id": {
      "type": "string",
      "title": "Gudang"
    },
    "warehouse_name": {
      "type": "string",
      "title": "Nama Gudang"
    },
    "account_id": {
      "type": "string",
      "title": "Rekening"
    },
    "account_name": {
      "type": "string",
      "title": "Nama Rekening"
    },
    "salesperson_id": {
      "type": "string",
      "title": "Sales"
    },
    "salesperson_name": {
      "type": "string",
      "title": "Nama Sales"
    },
    "sale_type": {
      "type": "string",
      "title": "Tipe",
      "enum": [
        "retail",
        "grosir"
      ],
      "default": "retail"
    },
    "payment_method": {
      "type": "string",
      "title": "Metode Bayar",
      "enum": [
        "tunai",
        "kredit"
      ],
      "default": "tunai"
    },
    "due_date": {
      "type": "string",
      "title": "Jatuh Tempo"
    },
    "items": {
      "type": "array",
      "title": "Item",
      "items": {
        "type": "object",
        "properties": {
          "product_id": {
            "type": "string"
          },
          "product_name": {
            "type": "string"
          },
          "sku": {
            "type": "string"
          },
          "qty": {
            "type": "number"
          },
          "price": {
            "type": "number"
          },
          "subtotal": {
            "type": "number"
          }
        }
      },
      "default": []
    },
    "total": {
      "type": "number",
      "title": "Total",
      "default": 0
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "draft",
        "posted"
      ],
      "default": "draft"
    },
    "note": {
      "type": "string",
      "title": "Catatan"
    }
  },
  "required": [
    "code",
    "date",
    "branch_id",
    "warehouse_id",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.branch_id": {
            "$in": "{{user.data.accessible_branch_ids}}"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.branch_id": {
            "$in": "{{user.data.accessible_branch_ids}}"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.branch_id": {
            "$in": "{{user.data.accessible_branch_ids}}"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.branch_id": {
            "$in": "{{user.data.accessible_branch_ids}}"
          }
        }
      ]
    }
  }
}