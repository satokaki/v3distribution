{
  "name": "StockLedger",
  "type": "object",
  "properties": {
    "product_id": {
      "type": "string",
      "title": "Produk"
    },
    "product_name": {
      "type": "string",
      "title": "Nama Produk"
    },
    "sku": {
      "type": "string",
      "title": "SKU"
    },
    "branch_id": {
      "type": "string",
      "title": "Cabang"
    },
    "balance_scope": {
      "type": "string",
      "title": "Cakupan Saldo",
      "enum": [
        "branch",
        "warehouse_legacy"
      ]
    },
    "branch_code": {
      "type": "string",
      "title": "Kode Cabang"
    },
    "warehouse_id": {
      "type": "string",
      "title": "Gudang"
    },
    "warehouse_name": {
      "type": "string",
      "title": "Nama Gudang"
    },
    "movement_type": {
      "type": "string",
      "title": "Tipe Mutasi",
      "enum": [
        "in",
        "out",
        "transfer_in",
        "transfer_out",
        "opname_in",
        "opname_out",
        "adjustment"
      ],
      "default": "in"
    },
    "transaction_type": {
      "type": "string",
      "title": "Tipe Transaksi V3"
    },
    "ref_type": {
      "type": "string",
      "title": "Jenis Referensi"
    },
    "ref_id": {
      "type": "string",
      "title": "ID Referensi"
    },
    "transaction_id": {
      "type": "string",
      "title": "ID Transaksi V3"
    },
    "ref_code": {
      "type": "string",
      "title": "Kode Referensi"
    },
    "reference_number": {
      "type": "string",
      "title": "Nomor Referensi V3"
    },
    "quantity": {
      "type": "number",
      "title": "Jumlah",
      "default": 0
    },
    "balance_after": {
      "type": "number",
      "title": "Saldo Setelah",
      "default": 0
    },
    "note": {
      "type": "string",
      "title": "Catatan"
    },
    "date": {
      "type": "string",
      "title": "Tanggal"
    },
    "transaction_date": {
      "type": "string",
      "title": "Tanggal Transaksi V3"
    }
  },
  "required": [
    "product_id",
    "branch_id",
    "movement_type",
    "quantity",
    "date"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.branch_id": {
            "$in": "{{user.data.accessible_branch_ids}}"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.branch_id": {
            "$in": "{{user.data.accessible_branch_ids}}"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
