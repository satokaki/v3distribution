{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "description": "Role platform: admin (super admin) atau user (cabang). Dipakai oleh RLS user_condition.role.",
      "enum": [
        "admin",
        "user"
      ]
    },
    "app_role": {
      "type": "string",
      "title": "Role Aplikasi (granular)",
      "enum": [
        "super_admin",
        "kepala_cabang",
        "admin_cabang",
        "kasir",
        "gudang",
        "finance"
      ]
    },
    "user_code": {
      "type": "string",
      "title": "Kode User"
    },
    "display_name": {
      "type": "string",
      "title": "Nama Tampilan"
    },
    "phone": {
      "type": "string",
      "title": "Nomor Telepon"
    },
    "default_branch_id": {
      "type": "string",
      "title": "Cabang Default"
    },
    "accessible_branch_ids": {
      "type": "array",
      "title": "Cabang yang Diakses",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "status": {
      "type": "string",
      "title": "Status Akun",
      "enum": [
        "active",
        "inactive"
      ],
      "default": "active"
    },
    "last_login_at": {
      "type": "string",
      "title": "Login Terakhir"
    }
  },
  "required": [
    "role"
  ]
}