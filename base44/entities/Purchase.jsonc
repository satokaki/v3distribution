{
  "name": "Purchase",
  "type": "object",
  "properties": {
    "code": {
      "type": "string",
      "title": "Kode Pembelian"
    },
    "date": {
      "type": "string",
      "title": "Tanggal"
    },
    "supplier_id": {
      "type": "string",
      "title": "Supplier"
    },
    "supplier_name": {
      "type": "string",
      "title": "Nama Supplier"
    },
    "branch_id": {
      "type": "string",
      "title": "Cabang"
    },
    "branch_code": {
      "type": "string",
      "title": "Kode Cabang"
    },
    "warehouse_id": {
      "type": "string",
      "title": "Gudang"
    },
    "warehouse_name": {
      "type": "string",
      "title": "Nama Gudang"
    },
    "account_id": {
      "type": "string",
      "title": "Rekening"
    },
    "account_name": {
      "type": "string",
      "title": "Nama Rekening"
    },
    "payment_method": {
      "type": "string",
      "title": "Metode Bayar",
      "enum": [
        "tunai",
        "kredit"
      ],
      "default": "tunai"
    },
    "payment_channel": {
      "type": "string",
      "title": "Kanal Pembayaran"
    },
    "due_date": {
      "type": "string",
      "title": "Jatuh Tempo"
    },
    "items": {
      "type": "array",
      "title": "Item",
      "items": {
        "type": "object",
        "properties": {
          "product_id": {
            "type": "string"
          },
          "product_name": {
            "type": "string"
          },
          "sku": {
            "type": "string"
          },
          "qty": {
            "type": "number"
          },
          "price": {
            "type": "number"
          },
          "discount_percent": {
            "type": "number",
            "default": 0
          },
          "discount_amount": {
            "type": "number",
            "default": 0
          },
          "price_source": {
            "type": "string"
          },
          "subtotal": {
            "type": "number"
          }
        }
      },
      "default": []
    },
    "total": {
      "type": "number",
      "title": "Total",
      "default": 0
    },
    "subtotal": {
      "type": "number",
      "default": 0
    },
    "discount_total": {
      "type": "number",
      "default": 0
    },
    "total_qty": {
      "type": "number",
      "default": 0
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "draft",
        "posted",
        "void",
        "returned"
      ],
      "default": "draft"
    },
    "note": {
      "type": "string",
      "title": "Catatan"
    }
  },
  "required": [
    "code",
    "date",
    "branch_id",
    "warehouse_id",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.branch_id": {
            "$in": "{{user.data.accessible_branch_ids}}"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.branch_id": {
            "$in": "{{user.data.accessible_branch_ids}}"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.branch_id": {
            "$in": "{{user.data.accessible_branch_ids}}"
          }
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "data.status": "draft"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "data.branch_id": {
                "$in": "{{user.data.accessible_branch_ids}}"
              }
            }
          ]
        }
      ]
    }
  }
}
