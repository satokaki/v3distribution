{
  "name": "StockTransfer",
  "type": "object",
  "properties": {
    "code": {
      "type": "string",
      "title": "Kode Mutasi"
    },
    "transfer_number": {
      "type": "string",
      "title": "Nomor Mutasi"
    },
    "date": {
      "type": "string",
      "title": "Tanggal"
    },
    "from_branch_id": {
      "type": "string",
      "title": "Cabang Asal"
    },
    "source_branch_id": {
      "type": "string",
      "title": "Cabang Asal V3"
    },
    "source_branch_code": {
      "type": "string",
      "title": "Kode Cabang Asal V3"
    },
    "source_branch_name": {
      "type": "string",
      "title": "Nama Cabang Asal V3"
    },
    "from_branch_code": {
      "type": "string",
      "title": "Kode Asal"
    },
    "from_branch_name": {
      "type": "string",
      "title": "Nama Asal"
    },
    "from_warehouse_id": {
      "type": "string",
      "title": "Gudang Asal"
    },
    "from_warehouse_name": {
      "type": "string",
      "title": "Nama Gudang Asal"
    },
    "to_branch_id": {
      "type": "string",
      "title": "Cabang Tujuan"
    },
    "destination_branch_id": {
      "type": "string",
      "title": "Cabang Tujuan V3"
    },
    "destination_branch_code": {
      "type": "string",
      "title": "Kode Cabang Tujuan V3"
    },
    "destination_branch_name": {
      "type": "string",
      "title": "Nama Cabang Tujuan V3"
    },
    "to_branch_code": {
      "type": "string",
      "title": "Kode Tujuan"
    },
    "to_branch_name": {
      "type": "string",
      "title": "Nama Tujuan"
    },
    "to_warehouse_id": {
      "type": "string",
      "title": "Gudang Tujuan"
    },
    "to_warehouse_name": {
      "type": "string",
      "title": "Nama Gudang Tujuan"
    },
    "items": {
      "type": "array",
      "title": "Item",
      "items": {
        "type": "object",
        "properties": {
          "product_id": {
            "type": "string"
          },
          "product_name": {
            "type": "string"
          },
          "sku": {
            "type": "string"
          },
          "qty": {
            "type": "number"
          },
          "requested_qty": {
            "type": "number"
          },
          "approved_qty": {
            "type": "number"
          },
          "received_qty": {
            "type": "number"
          },
          "difference_qty": {
            "type": "number"
          },
          "in_transit_qty": {
            "type": "number"
          },
          "unit": {
            "type": "string"
          }
        }
      },
      "default": []
    },
    "total_qty": {
      "type": "number",
      "title": "Total Qty",
      "default": 0
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "draft",
        "approved",
        "received",
        "posted"
      ],
      "default": "draft"
    },
    "note": {
      "type": "string",
      "title": "Catatan"
    },
    "notes": {
      "type": "string",
      "title": "Catatan V3"
    },
    "receiving_notes": {
      "type": "string",
      "title": "Catatan Penerimaan"
    },
    "approved_at": {
      "type": "string",
      "title": "Waktu Persetujuan"
    },
    "approved_by": {
      "type": "string",
      "title": "Disetujui Oleh"
    },
    "received_at": {
      "type": "string",
      "title": "Waktu Penerimaan"
    },
    "received_by": {
      "type": "string",
      "title": "Diterima Oleh"
    },
    "approval_request_id": {
      "type": "string",
      "title": "Idempotency Approval"
    },
    "receiving_request_id": {
      "type": "string",
      "title": "Idempotency Penerimaan"
    }
  },
  "required": [
    "code",
    "date",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.from_branch_id": {
            "$in": "{{user.data.accessible_branch_ids}}"
          }
        },
        {
          "data.source_branch_id": {
            "$in": "{{user.data.accessible_branch_ids}}"
          }
        },
        {
          "data.to_branch_id": {
            "$in": "{{user.data.accessible_branch_ids}}"
          }
        },
        {
          "data.destination_branch_id": {
            "$in": "{{user.data.accessible_branch_ids}}"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
