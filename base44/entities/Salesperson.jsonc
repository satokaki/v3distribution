{
  "name": "Salesperson",
  "type": "object",
  "properties": {
    "code": {
      "type": "string",
      "title": "Kode Sales"
    },
    "name": {
      "type": "string",
      "title": "Nama Sales"
    },
    "branch_id": {
      "type": "string",
      "title": "Cabang"
    },
    "branch_code": {
      "type": "string",
      "title": "Kode Cabang"
    },
    "phone": {
      "type": "string",
      "title": "Nomor Telepon"
    },
    "join_date": {
      "type": "string",
      "format": "date",
      "title": "Tanggal Bergabung"
    },
    "notes": {
      "type": "string",
      "title": "Catatan"
    },
    "is_active": {
      "type": "boolean",
      "title": "Status Aktif",
      "default": true
    }
  },
  "required": [
    "code",
    "name",
    "branch_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.branch_id": {
            "$in": "{{user.data.accessible_branch_ids}}"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.branch_id": {
            "$in": "{{user.data.accessible_branch_ids}}"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.branch_id": {
            "$in": "{{user.data.accessible_branch_ids}}"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.branch_id": {
            "$in": "{{user.data.accessible_branch_ids}}"
          }
        }
      ]
    }
  }
}